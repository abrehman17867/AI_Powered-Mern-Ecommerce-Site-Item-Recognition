# Copy to .env.local for local development, and set the same keys in the
# Vercel project settings (Settings -> Environment Variables) for production.

# MongoDB Atlas connection string (include the database name)
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/ecommerce?retryWrites=true&w=majority

# Secret used to sign JWTs
SECRET_KEY=change_me

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public origin of the deployed site, used for Stripe redirect URLs.
# Leave unset locally; set to https://your-app.vercel.app in production.
CLIENT_URL=

# Optional: enables visual search via the Hugging Face Inference API.
# Create a free token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Outbound email (password reset). Gmail requires an App Password, not your
# account password: Google Account > Security > 2-Step Verification > App passwords.
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# Optional overrides
# MAIL_FROM="Ecommerce <you@gmail.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# RESET_TOKEN_TTL_MINUTES=60
